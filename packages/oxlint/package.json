{
  "name": "oxlint-tsrx",
  "version": "0.1.0",
  "description": "Oxlint-compatible command package with native TSRX support",
  "keywords": [
    "eslint",
    "javascript",
    "linter",
    "oxc",
    "oxlint",
    "tsrx",
    "typescript"
  ],
  "homepage": "https://oxc-tsrx-docs.vercel.app/",
  "bugs": {
    "url": "https://github.com/markless-dev/oxc-tsrx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markless-dev/oxc-tsrx.git",
    "directory": "packages/oxlint"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oxlint": "./bin/oxlint"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins-dev": {
      "types": "./dist/plugins-dev.d.ts",
      "default": "./dist/plugins-dev.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@oxc-tsrx/runtime": "0.1.0",
    "oxlint-current": "npm:oxlint@1.74.0",
    "oxlint-tsgolint": "0.24.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
