{
  "name": "@oxc-tsrx/tsrx-core-compat",
  "version": "0.3.0",
  "description": "A dependency-light @tsrx/core parser facade powered by oxc-tsrx/parser",
  "keywords": [
    "oxc",
    "parser",
    "tsrx"
  ],
  "homepage": "https://thejackshelton.github.io/oxc-tsrx/",
  "bugs": {
    "url": "https://github.com/thejackshelton/oxc-tsrx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejackshelton/oxc-tsrx.git",
    "directory": "packages/tsrx-core-compat"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./types/estree": {
      "types": "./dist/types/estree.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@oxc-project/types": "0.140.0",
    "oxc-tsrx": "0.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
