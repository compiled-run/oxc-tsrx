{
  "name": "@oxc-tsrx/runtime",
  "version": "0.1.0",
  "description": "Thin native-process and file-discovery runtime for OXC for TSRX npm companions",
  "keywords": [
    "oxc",
    "oxfmt",
    "oxlint",
    "tsrx"
  ],
  "homepage": "https://oxc-tsrx-docs.vercel.app/",
  "bugs": {
    "url": "https://github.com/markless-dev/oxc-tsrx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markless-dev/oxc-tsrx.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package-binary": "./dist/package-binary.js",
    "./process": "./dist/process.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "tinyglobby": "0.2.17"
  },
  "optionalDependencies": {
    "@oxc-tsrx/native-darwin-arm64": "0.1.0",
    "@oxc-tsrx/native-darwin-x64": "0.1.0",
    "@oxc-tsrx/native-linux-arm64-gnu": "0.1.0",
    "@oxc-tsrx/native-linux-arm64-musl": "0.1.0",
    "@oxc-tsrx/native-linux-x64-gnu": "0.1.0",
    "@oxc-tsrx/native-linux-x64-musl": "0.1.0",
    "@oxc-tsrx/native-win32-arm64-msvc": "0.1.0",
    "@oxc-tsrx/native-win32-x64-msvc": "0.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
