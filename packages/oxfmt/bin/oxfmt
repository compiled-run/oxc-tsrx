#!/usr/bin/env node

try {
  const { canRunCanonicalOxfmt, importDeclaredPackageBinary } = await import('../dist/invocation.js');
  const args = process.argv.slice(2);
  if (canRunCanonicalOxfmt(args)) {
    // Oxfmt's declared launcher owns stdin, config callbacks, worker cleanup,
    // output, and exit behavior. Importing it avoids a second Node process
    // without duplicating private N-API wiring.
    await importDeclaredPackageBinary('oxfmt-current', 'oxfmt', import.meta.url);
  } else {
    const { runCli } = await import('../dist/cli.js');
    process.exitCode = await runCli(args);
  }
} catch (error) {
  console.error(`oxfmt (OXC for TSRX): ${error instanceof Error ? error.message : String(error)}`);
  process.exitCode = 2;
}
