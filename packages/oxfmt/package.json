{
  "name": "oxfmt-tsrx",
  "version": "0.1.0",
  "description": "Oxfmt-compatible command and API package with native TSRX support",
  "keywords": [
    "formatter",
    "javascript",
    "oxc",
    "oxfmt",
    "prettier",
    "tsrx",
    "typescript"
  ],
  "homepage": "https://thejackshelton.github.io/oxc-tsrx/",
  "bugs": {
    "url": "https://github.com/thejackshelton/oxc-tsrx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejackshelton/oxc-tsrx.git",
    "directory": "packages/oxfmt"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oxfmt": "./bin/oxfmt"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@oxc-tsrx/runtime": "0.1.0",
    "oxfmt-current": "npm:oxfmt@0.59.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
