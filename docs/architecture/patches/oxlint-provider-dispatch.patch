@@ -0,0 +1,183 @@
+import { spawn } from "node:child_process";
+import { statSync } from "node:fs";
+import {
+  discoverProviders,
+  extensionOf,
+  findProjectRoot,
+  type ProviderIndex,
+} from "./resolve.ts";
+import { LOG_PREFIX, PROVIDER_DISABLED_ENV, usesNodeInterpreter } from "./shared.ts";
+
+/**
+ * Provider dispatch sits *above* the NAPI addon, at the one existing call site.
+ *
+ * Nothing crosses into Rust: the `lint(...)` signature is untouched, so this is
+ * a JavaScript-only change. The wrapper partitions the command line, keeps every
+ * path Oxlint already owns on today's exact in-process `lint(...)` call, and
+ * executes the declared capability binary for the paths a provider owns.
+ *
+ * The property an empty index must have, and does have, is that
+ * `createProviderDispatch` returns `null` and `cli.ts` runs the pre-existing
+ * statement unchanged. No extra process, no extra argument, no reordering.
+ */
+
+export interface ProviderDispatch {
+  run(lintCanonical: (args: string[]) => Promise<boolean>): Promise<boolean>;
+}
+
+function report(message: string): void {
+  process.stderr.write(`${LOG_PREFIX}${message}\n`);
+}
+
+/**
+ * Discover the index for this invocation, or `null` when nothing can change.
+ *
+ * Cost when no provider is installed: one `package.json` read at the project
+ * root, then one module resolution plus one manifest read per direct
+ * dependency, once per process. No provider code is imported or executed.
+ */
+async function loadIndex(cwd: string): Promise<ProviderIndex | null> {
+  const root = await findProjectRoot(cwd);
+  if (root === null) return null;
+  const index = await discoverProviders({ root });
+  for (const entry of index.diagnostics) report(`${entry.severity}: ${entry.message}`);
+  if (Object.keys(index.extensions).length === 0) return null;
+  return index;
+}
+
+/**
+ * Split the command line into the arguments Oxlint keeps and the paths each
+ * provider owns.
+ *
+ * The rule is deliberately narrow: an argument is provider-owned only when its
+ * extension is in the index *and* it names an existing file. It can never be
+ * some option's value, because protocol 1 reserves every extension an Oxlint
+ * option value can carry — a config path is `.json`, `.jsonc`, `.ts`, or `.js`,
+ * and all four are reserved, so no provider is permitted to claim them. Globs
+ * and ignore patterns are not existing files and so are never captured either.
+ *
+ * Directory and glob traversal is deliberately *not* partitioned: when the user
+ * passes no explicit path, Oxlint's own file walker runs exactly as today and no
+ * provider is invoked. Teaching the walker about provider extensions is a Rust
+ * change and is not part of this patch.
+ */
+export function partitionArguments(
+  args: readonly string[],
+  index: ProviderIndex,
+  exists: (path: string) => boolean = isFile,
+): { canonical: string[]; owned: Map<string, string[]> } {
+  const canonical: string[] = [];
+  const owned = new Map<string, string[]>();
+  for (const argument of args) {
+    const extension = argument.startsWith("-") ? null : extensionOf(argument);
+    const claim = extension === null ? undefined : index.extensions[extension];
+    if (claim === undefined || !exists(argument)) {
+      canonical.push(argument);
+      continue;
+    }
+    const group = owned.get(claim.extension);
+    if (group === undefined) owned.set(claim.extension, [argument]);
+    else group.push(argument);
+  }
+  return { canonical, owned };
+}
+
+function isFile(path: string): boolean {
+  try {
+    return statSync(path).isFile();
+  } catch {
+    return false;
+  }
+}
+
+/** `true` when at least one argument is an explicit path Oxlint already owns. */
+function hasCanonicalPath(args: readonly string[], claimed: readonly string[]): boolean {
+  return args.some(
+    (argument) =>
+      !argument.startsWith("-") && !claimed.includes(argument) && extensionOf(argument) !== null,
+  );
+}
+
+function runCapability(command: string, paths: string[], cwd: string): Promise<number> {
+  const [file, argv] = usesNodeInterpreter(command)
+    ? [process.execPath, [command, ...paths]]
+    : [command, paths];
+  return new Promise((resolve) => {
+    const child = spawn(file, argv, { cwd, stdio: "inherit", env: process.env });
+    child.on("error", (error) => {
+      report(`the ${command} lint capability could not start: ${error.message}`);
+      resolve(2);
+    });
+    child.on("close", (status) => resolve(status ?? 2));
+  });
+}
+
+/**
+ * Build a dispatcher, or `null` when this invocation must take today's exact
+ * code path. `null` is the answer for: the kill switch, no project root, no
+ * provider installed, no provider capability that applies, and every command
+ * line that names no provider-owned file.
+ */
+export async function createProviderDispatch(
+  args: readonly string[],
+  cwd: string = process.cwd(),
+): Promise<ProviderDispatch | null> {
+  if (process.env[PROVIDER_DISABLED_ENV] === "1") return null;
+
+  const index = await loadIndex(cwd);
+  if (index === null) return null;
+
+  if (args.includes("--lsp")) {
+    // The multiplexer runs the canonical language server by re-executing this
+    // same entry point with dispatch switched off, which is what keeps the
+    // canonical half byte-identical and needs no Rust change. Without a script
+    // path to re-execute there is nothing to compose, so the session takes
+    // today's path instead of failing.
+    const entry = process.argv[1];
+    if (typeof entry !== "string" || entry.length === 0) return null;
+    const { runProviderLsp } = await import("./lsp.ts");
+    return {
+      async run() {
+        const status = await runProviderLsp([...args], index, { cwd, entry });
+        return status === 0;
+      },
+    };
+  }
+
+  const { canonical, owned } = partitionArguments(args, index);
+  if (owned.size === 0) return null;
+
+  const claimed = [...owned.values()].flat();
+  const runCanonical = hasCanonicalPath(args, claimed);
+
+  return {
+    async run(lintCanonical) {
+      let success = true;
+      // Every path Oxlint already owns still goes through the identical
+      // in-process call. When the command line named provider files only,
+      // running it would make Oxlint walk the whole directory instead, so it
+      // is skipped rather than given a different meaning.
+      if (runCanonical) success = await lintCanonical(canonical);
+
+      for (const [extension, paths] of owned) {
+        const capability = index.extensions[extension]?.capabilities?.lint;
+        if (capability === undefined) {
+          report(
+            `${index.extensions[extension]?.package} claims ${extension} but declares no lint ` +
+              `capability; ${paths.length} file(s) were not linted`,
+          );
+          success = false;
+          continue;
+        }
+        if (capability.kind !== "bin" || typeof capability.path !== "string") {
+          report(`the ${extension} lint capability is not an executable binary`);
+          success = false;
+          continue;
+        }
+        const status = await runCapability(capability.path, paths, cwd);
+        if (status !== 0) success = false;
+      }
+      return success;
+    },
+  };
+}
