@@ -0,0 +1,633 @@
+import { readFile as readFileFromDisk } from "node:fs/promises";
+import { createRequire } from "node:module";
+import { dirname, join, parse, relative, resolve as resolvePath, sep } from "node:path";
+
+/**
+ * Static language-provider discovery.
+ *
+ * A *provider* is an ordinary npm package that declares one static top-level
+ * `oxc.provider` block in its own `package.json`. A host reads the project root
+ * manifest, takes the union of the direct dependency fields, resolves
+ * `<name>/package.json` for each, parses the JSON, and builds an extension
+ * index from what it finds.
+ *
+ * Nothing in this file imports, requires, executes, or spawns a candidate
+ * package: module resolution and `JSON.parse` are the only operations performed
+ * against a dependency. Discovery is therefore safe to run unconditionally, and
+ * a project with no provider installed pays one manifest read per direct
+ * dependency and nothing else.
+ *
+ * The module deliberately contains no knowledge of any individual provider.
+ */
+
+export const PROTOCOL_VERSION = 1;
+export const SUPPORTED_PROTOCOLS: readonly number[] = Object.freeze([1]);
+export const CAPABILITY_NAMES = Object.freeze(["parse", "lint", "format", "lsp"] as const);
+export const DEPENDENCY_FIELDS = Object.freeze([
+  "dependencies",
+  "devDependencies",
+  "optionalDependencies",
+] as const);
+
+/**
+ * Extensions the core toolchain owns. A provider claiming one is a hard error,
+ * which is what structurally keeps ordinary source files off provider paths:
+ * no provider can ever take `.ts`, `.js`, or a config file extension away from
+ * Oxlint itself.
+ */
+export const RESERVED_EXTENSIONS: readonly string[] = Object.freeze([
+  ".astro",
+  ".cjs",
+  ".cts",
+  ".js",
+  ".json",
+  ".json5",
+  ".jsonc",
+  ".jsx",
+  ".mjs",
+  ".mts",
+  ".svelte",
+  ".ts",
+  ".tsx",
+  ".vue",
+]);
+
+const RESERVED = new Set(RESERVED_EXTENSIONS);
+const IDENTIFIER = /^[a-z][a-z0-9-]*$/u;
+
+export type CapabilityName = (typeof CAPABILITY_NAMES)[number];
+
+export type CapabilityTarget =
+  | { kind: "bin"; bin: string; path: string }
+  | { kind: "module"; subpath: string; specifier: string; path: string | null };
+
+export interface ProviderLanguage {
+  id: string;
+  extensions: string[];
+  capabilities: Partial<Record<CapabilityName, CapabilityTarget>>;
+}
+
+export interface Provider {
+  name: string;
+  version: string | null;
+  root: string;
+  manifest: string;
+  protocol: number;
+  id: string;
+  languages: ProviderLanguage[];
+}
+
+export interface ProviderDiagnostic {
+  severity: "error" | "warning";
+  code: string;
+  message: string;
+  packages?: string[];
+  [key: string]: unknown;
+}
+
+export interface ExtensionClaim {
+  extension: string;
+  package: string;
+  providerId: string;
+  providerRoot: string;
+  language: string;
+  capabilities: Partial<Record<CapabilityName, CapabilityTarget>>;
+}
+
+export interface ProviderIndex {
+  root: string;
+  providers: Provider[];
+  extensions: Record<string, ExtensionClaim>;
+  diagnostics: ProviderDiagnostic[];
+}
+
+/** Issuer-aware resolution, the same `(request, issuer)` shape Yarn PnP exposes. */
+export type Resolver = (request: string, issuer: string) => string;
+export type Reader = (path: string, encoding: "utf8") => Promise<string>;
+
+export interface DiscoverOptions {
+  root?: string;
+  resolve?: Resolver;
+  readFile?: Reader;
+  protocols?: readonly number[];
+}
+
+function defaultReadFile(path: string): Promise<string> {
+  return readFileFromDisk(path, "utf8");
+}
+
+/**
+ * A host with a different module map (Yarn PnP) injects `pnp.resolveRequest`,
+ * which already has exactly this signature.
+ */
+function createDefaultResolver(): Resolver {
+  const requires = new Map<string, NodeJS.Require>();
+  return (request, issuer) => {
+    let resolver = requires.get(issuer);
+    if (resolver === undefined) {
+      resolver = createRequire(issuer);
+      requires.set(issuer, resolver);
+    }
+    return resolver.resolve(request);
+  };
+}
+
+function isPlainObject(value: unknown): value is Record<string, any> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function diagnostic(
+  severity: "error" | "warning",
+  code: string,
+  message: string,
+  details: Record<string, unknown> = {},
+): ProviderDiagnostic {
+  return { severity, code, message, ...details };
+}
+
+function isInside(directory: string, path: string): boolean {
+  const offset = relative(directory, path);
+  return offset.length > 0 && !offset.startsWith("..") && !offset.startsWith(sep);
+}
+
+/** Union of the direct dependency fields, sorted for deterministic output. */
+export function dependencyNames(manifest: unknown): string[] {
+  const names = new Set<string>();
+  for (const field of DEPENDENCY_FIELDS) {
+    const declared = isPlainObject(manifest) ? manifest[field] : undefined;
+    if (!isPlainObject(declared)) continue;
+    for (const name of Object.keys(declared)) names.add(name);
+  }
+  return [...names].sort();
+}
+
+export function providerDeclaration(manifest: unknown): Record<string, any> | null {
+  const declaration = isPlainObject(manifest) ? manifest.oxc?.provider : undefined;
+  return isPlainObject(declaration) ? declaration : null;
+}
+
+export function extensionOf(filePath: unknown): string | null {
+  if (typeof filePath !== "string") return null;
+  const name = filePath.split(/[/\\]/u).at(-1) ?? "";
+  const dot = name.lastIndexOf(".");
+  if (dot <= 0) return null;
+  return name.slice(dot).toLowerCase();
+}
+
+export function isReservedExtension(extension: unknown): boolean {
+  return typeof extension === "string" && RESERVED.has(extension.toLowerCase());
+}
+
+/** The nearest ancestor directory of `start` that contains a `package.json`. */
+export async function findProjectRoot(
+  start: string = process.cwd(),
+  readFile: Reader = defaultReadFile,
+): Promise<string | null> {
+  const from = resolvePath(start);
+  const filesystemRoot = parse(from).root;
+  let directory = from;
+  for (;;) {
+    try {
+      await readFile(join(directory, "package.json"), "utf8");
+      return directory;
+    } catch {
+      if (directory === filesystemRoot) return null;
+      directory = dirname(directory);
+    }
+  }
+}
+
+function normalizeBinMap(manifest: Record<string, any>): Record<string, string> {
+  if (typeof manifest.bin === "string") {
+    return typeof manifest.name === "string" ? { [manifest.name]: manifest.bin } : {};
+  }
+  return isPlainObject(manifest.bin) ? manifest.bin : {};
+}
+
+function moduleSpecifier(name: string, subpath: string): string {
+  if (subpath === ".") return name;
+  return `${name}/${subpath.replace(/^\.\/?/u, "")}`;
+}
+
+interface ReadContext {
+  diagnostics: ProviderDiagnostic[];
+  protocols: Set<number>;
+  resolve: Resolver;
+  readFile: Reader;
+  issuer: string;
+  name?: string;
+  manifest?: Record<string, any>;
+  providerRoot?: string;
+}
+
+function readCapabilityTarget(
+  capability: CapabilityName,
+  value: unknown,
+  context: ReadContext,
+): CapabilityTarget | null {
+  const { name, providerRoot, manifest, diagnostics, resolve, issuer } = context as Required<
+    Pick<ReadContext, "name" | "providerRoot" | "manifest">
+  > &
+    ReadContext;
+  if (!isPlainObject(value)) {
+    diagnostics.push(
+      diagnostic(
+        "warning",
+        "invalid-capability",
+        `package ${name} declares a non-object ${capability} capability`,
+        { packages: [name], capability },
+      ),
+    );
+    return null;
+  }
+  if (typeof value.bin === "string" && value.bin.length > 0) {
+    const declared = normalizeBinMap(manifest)[value.bin];
+    if (typeof declared !== "string" || declared.length === 0) {
+      diagnostics.push(
+        diagnostic(
+          "warning",
+          "invalid-capability",
+          `package ${name} declares the ${capability} capability as bin "${value.bin}", ` +
+            `which is not a key of its own bin map`,
+          { packages: [name], capability },
+        ),
+      );
+      return null;
+    }
+    const path = resolvePath(providerRoot, declared);
+    if (!isInside(providerRoot, path)) {
+      diagnostics.push(
+        diagnostic(
+          "warning",
+          "invalid-capability",
+          `package ${name} declares the ${capability} capability outside its own package directory`,
+          { packages: [name], capability },
+        ),
+      );
+      return null;
+    }
+    return { kind: "bin", bin: value.bin, path };
+  }
+  if (typeof value.module === "string" && value.module.startsWith(".")) {
+    const specifier = moduleSpecifier(name, value.module);
+    let path: string | null = null;
+    try {
+      path = resolve(specifier, issuer);
+    } catch {
+      diagnostics.push(
+        diagnostic(
+          "warning",
+          "unresolved-capability",
+          `package ${name} declares the ${capability} capability at ${specifier}, ` +
+            `which its exports map does not resolve for this host`,
+          { packages: [name], capability },
+        ),
+      );
+    }
+    return { kind: "module", subpath: value.module, specifier, path };
+  }
+  diagnostics.push(
+    diagnostic(
+      "warning",
+      "invalid-capability",
+      `package ${name} declares a ${capability} capability that is neither an export subpath ` +
+        `nor an own bin key`,
+      { packages: [name], capability },
+    ),
+  );
+  return null;
+}
+
+function readCapabilities(
+  declared: unknown,
+  context: ReadContext,
+): Partial<Record<CapabilityName, CapabilityTarget>> {
+  const capabilities: Partial<Record<CapabilityName, CapabilityTarget>> = {};
+  if (!isPlainObject(declared)) return capabilities;
+  for (const capability of CAPABILITY_NAMES) {
+    const value = declared[capability];
+    if (value === undefined) continue;
+    const target = readCapabilityTarget(capability, value, context);
+    if (target !== null) capabilities[capability] = target;
+  }
+  return capabilities;
+}
+
+function readLanguages(declared: unknown, context: ReadContext): ProviderLanguage[] {
+  const { name, diagnostics } = context;
+  if (!Array.isArray(declared) || declared.length === 0) {
+    diagnostics.push(
+      diagnostic("warning", "invalid-provider", `package ${name} declares no provider languages`, {
+        packages: [name!],
+      }),
+    );
+    return [];
+  }
+  const languages: ProviderLanguage[] = [];
+  for (const entry of declared) {
+    if (!isPlainObject(entry) || typeof entry.id !== "string" || !IDENTIFIER.test(entry.id)) {
+      diagnostics.push(
+        diagnostic(
+          "warning",
+          "invalid-provider",
+          `package ${name} declares a language without a valid id`,
+          { packages: [name!] },
+        ),
+      );
+      continue;
+    }
+    const extensions: string[] = [];
+    for (const extension of Array.isArray(entry.extensions) ? entry.extensions : []) {
+      if (
+        typeof extension !== "string" ||
+        extension.length < 2 ||
+        !extension.startsWith(".") ||
+        extension !== extension.toLowerCase() ||
+        /[\s/\\]/u.test(extension)
+      ) {
+        diagnostics.push(
+          diagnostic(
+            "warning",
+            "invalid-provider",
+            `package ${name} declares the malformed extension ${JSON.stringify(extension)} ` +
+              `for language ${entry.id}`,
+            { packages: [name!] },
+          ),
+        );
+        continue;
+      }
+      if (RESERVED.has(extension)) {
+        diagnostics.push(
+          diagnostic(
+            "error",
+            "reserved-extension",
+            `package ${name} claims the reserved ${extension} extension, which protocol ` +
+              `${PROTOCOL_VERSION} keeps on the core toolchain`,
+            { packages: [name!], extension },
+          ),
+        );
+        continue;
+      }
+      if (!extensions.includes(extension)) extensions.push(extension);
+    }
+    if (extensions.length === 0) continue;
+    languages.push({
+      id: entry.id,
+      extensions,
+      capabilities: readCapabilities(entry.capabilities, context),
+    });
+  }
+  return languages;
+}
+
+interface DependencyRecord {
+  manifestPath: string;
+  root: string;
+  manifest: Record<string, any>;
+}
+
+function readProvider(
+  name: string,
+  record: DependencyRecord,
+  declaration: Record<string, any>,
+  context: ReadContext,
+): Provider | null {
+  const { diagnostics, protocols } = context;
+  const { protocol, id } = declaration;
+  if (!Number.isInteger(protocol)) {
+    diagnostics.push(
+      diagnostic(
+        "warning",
+        "invalid-provider",
+        `package ${name} declares a non-integer provider protocol`,
+        { packages: [name] },
+      ),
+    );
+    return null;
+  }
+  if (!protocols.has(protocol)) {
+    diagnostics.push(
+      diagnostic(
+        "warning",
+        "unsupported-protocol",
+        `package ${name} declares provider protocol ${protocol}, which this host does not ` +
+          `support; it is ignored`,
+        { packages: [name], protocol },
+      ),
+    );
+    return null;
+  }
+  if (typeof id !== "string" || !IDENTIFIER.test(id)) {
+    diagnostics.push(
+      diagnostic(
+        "warning",
+        "invalid-provider",
+        `package ${name} declares an invalid provider id ${JSON.stringify(id ?? null)}`,
+        { packages: [name] },
+      ),
+    );
+    return null;
+  }
+  const languages = readLanguages(declaration.languages, {
+    ...context,
+    name,
+    manifest: record.manifest,
+    providerRoot: record.root,
+  });
+  if (languages.length === 0) return null;
+  return {
+    name,
+    version: typeof record.manifest.version === "string" ? record.manifest.version : null,
+    root: record.root,
+    manifest: record.manifestPath,
+    protocol,
+    id,
+    languages,
+  };
+}
+
+/**
+ * Read one candidate dependency's manifest.
+ *
+ * The two failure modes below look alike and are not alike. Resolution failing
+ * means the package is simply not installed, which is ordinary and stays quiet;
+ * an uninstalled optional dependency must never warn. A manifest that resolves
+ * and then cannot be read or parsed is different: resolution already proved the
+ * package is there, so failing to read it is a host or environment fault, and it
+ * must never be mistaken for "this package is not a provider".
+ */
+async function readDependencyManifest(
+  name: string,
+  issuer: string,
+  resolve: Resolver,
+  readFile: Reader,
+  diagnostics: ProviderDiagnostic[],
+): Promise<DependencyRecord | null> {
+  let manifestPath: string;
+  try {
+    manifestPath = resolve(`${name}/package.json`, issuer);
+  } catch {
+    // Not installed. Ordinary, and deliberately quiet.
+    return null;
+  }
+  let manifest: unknown;
+  try {
+    manifest = JSON.parse(await readFile(manifestPath, "utf8"));
+  } catch (error) {
+    diagnostics.push(
+      diagnostic(
+        "warning",
+        "unreadable-manifest",
+        `package ${name} resolved to ${manifestPath}, which this host could not read or parse: ` +
+          `${error instanceof Error ? error.message : String(error)}`,
+        { packages: [name], manifest: manifestPath },
+      ),
+    );
+    return null;
+  }
+  if (!isPlainObject(manifest)) {
+    diagnostics.push(
+      diagnostic(
+        "warning",
+        "unreadable-manifest",
+        `package ${name} resolved to ${manifestPath}, which does not contain a JSON object`,
+        { packages: [name], manifest: manifestPath },
+      ),
+    );
+    return null;
+  }
+  return { manifestPath, root: dirname(manifestPath), manifest };
+}
+
+export const EMPTY_INDEX: ProviderIndex = Object.freeze({
+  root: "",
+  providers: Object.freeze([]) as unknown as Provider[],
+  extensions: Object.freeze({}) as Record<string, ExtensionClaim>,
+  diagnostics: Object.freeze([]) as unknown as ProviderDiagnostic[],
+});
+
+/**
+ * Build the provider index for one project root.
+ *
+ * Never throws and never rejects: a host that cannot read a manifest must still
+ * lint. Fatal protocol violations (a reserved extension, two providers claiming
+ * one extension, two providers claiming one id) drop the offending claim and
+ * record an `error` diagnostic, which the caller reports and then continues on
+ * the canonical path.
+ */
+export async function discoverProviders(options: DiscoverOptions = {}): Promise<ProviderIndex> {
+  const root = resolvePath(options.root ?? process.cwd());
+  const readFile = options.readFile ?? defaultReadFile;
+  const resolve = options.resolve ?? createDefaultResolver();
+  const protocols = new Set(options.protocols ?? SUPPORTED_PROTOCOLS);
+  const manifestPath = join(root, "package.json");
+  const diagnostics: ProviderDiagnostic[] = [];
+
+  let manifest: unknown;
+  try {
+    manifest = JSON.parse(await readFile(manifestPath, "utf8"));
+  } catch {
+    return { root, providers: [], extensions: {}, diagnostics };
+  }
+  const names = dependencyNames(manifest);
+  if (names.length === 0) return { root, providers: [], extensions: {}, diagnostics };
+
+  const context: ReadContext = {
+    diagnostics,
+    protocols,
+    resolve,
+    readFile,
+    issuer: manifestPath,
+  };
+
+  const declared: Provider[] = [];
+  for (const name of names) {
+    const record = await readDependencyManifest(name, manifestPath, resolve, readFile, diagnostics);
+    if (record === null) continue;
+    const declaration = providerDeclaration(record.manifest);
+    if (declaration === null) continue;
+    const provider = readProvider(name, record, declaration, context);
+    if (provider !== null) declared.push(provider);
+  }
+
+  const byIdentifier = new Map<string, Provider[]>();
+  for (const provider of declared) {
+    const group = byIdentifier.get(provider.id);
+    if (group === undefined) byIdentifier.set(provider.id, [provider]);
+    else group.push(provider);
+  }
+  const rejectedIdentifiers = new Set<string>();
+  for (const [id, group] of byIdentifier) {
+    if (group.length < 2) continue;
+    rejectedIdentifiers.add(id);
+    const packages = group.map((provider) => provider.name);
+    diagnostics.push(
+      diagnostic(
+        "error",
+        "duplicate-id",
+        `packages ${packages.join(" and ")} both declare the provider id "${id}"`,
+        { packages, id },
+      ),
+    );
+  }
+  const providers = declared.filter((provider) => !rejectedIdentifiers.has(provider.id));
+
+  const claims = new Map<string, { provider: Provider; language: ProviderLanguage }[]>();
+  for (const provider of providers) {
+    for (const language of provider.languages) {
+      for (const extension of language.extensions) {
+        const claim = { provider, language };
+        const group = claims.get(extension);
+        if (group === undefined) claims.set(extension, [claim]);
+        else group.push(claim);
+      }
+    }
+  }
+  const extensions: Record<string, ExtensionClaim> = {};
+  for (const extension of [...claims.keys()].sort()) {
+    const group = claims.get(extension)!;
+    if (group.length > 1) {
+      const packages = group.map((claim) => claim.provider.name);
+      diagnostics.push(
+        diagnostic(
+          "error",
+          "extension-conflict",
+          `packages ${packages.join(" and ")} both claim the ${extension} extension; ` +
+            `protocol ${PROTOCOL_VERSION} never picks a winner`,
+          { packages, extension },
+        ),
+      );
+      continue;
+    }
+    const [{ provider, language }] = group;
+    extensions[extension] = {
+      extension,
+      package: provider.name,
+      providerId: provider.id,
+      providerRoot: provider.root,
+      language: language.id,
+      capabilities: language.capabilities,
+    };
+  }
+
+  return { root, providers, extensions, diagnostics };
+}
+
+/**
+ * Look up one capability for one file. Returns `null` for every extension the
+ * index does not own, which is the fast path for ordinary source files.
+ */
+export function resolveCapability(
+  index: ProviderIndex | null | undefined,
+  filePath: string,
+  capability: CapabilityName,
+): (ExtensionClaim & CapabilityTarget & { capability: CapabilityName }) | null {
+  const extension = extensionOf(filePath);
+  if (extension === null) return null;
+  const entry = index?.extensions?.[extension];
+  if (entry === undefined) return null;
+  const target = entry.capabilities?.[capability];
+  if (target === undefined) return null;
+  return { ...entry, capability, ...target } as ExtensionClaim &
+    CapabilityTarget & { capability: CapabilityName };
+}
diff --git a/apps/oxlint/src-js/provider/shared.ts b/apps/oxlint/src-js/provider/shared.ts
new file mode 100644
index 000000000..d8fc76b2c
--- /dev/null
+++ b/apps/oxlint/src-js/provider/shared.ts
@@ -0,0 +1,44 @@
+import { closeSync, openSync, readSync } from "node:fs";
+
+/** Prefix for every message this layer writes to stderr. */
+export const LOG_PREFIX = "oxlint: ";
+
+/**
+ * Set to `1` to take the pre-provider code path exactly as it shipped before
+ * this feature existed. The multiplexer sets it on the canonical child it
+ * re-executes, and it doubles as the user-facing kill switch.
+ */
+export const PROVIDER_DISABLED_ENV = "OXLINT_NO_PROVIDERS";
+
+/**
+ * The real stdout writer, captured before `cli.ts` runs.
+ *
+ * In `--lsp` mode `cli.ts` reassigns `process.stdout.write` to stderr, because
+ * the language server protocol owns stdout and any stray JS write would corrupt
+ * it. When providers are multiplexed, this process *is* the server the editor
+ * talks to, so it needs the genuine stdout. This module is imported by `cli.ts`,
+ * so it is evaluated before that reassignment and captures the original.
+ */
+export const clientOutput: { write(chunk: Uint8Array | string): boolean } = {
+  write: process.stdout.write.bind(process.stdout),
+};
+
+/**
+ * A declared `bin` entry may be a JavaScript wrapper or a native executable.
+ * Reading the shebang is a static file read, not an execution of the package,
+ * so this stays inside the "discovery never runs provider code" rule.
+ */
+export function usesNodeInterpreter(path: string): boolean {
+  let descriptor: number | undefined;
+  try {
+    descriptor = openSync(path, "r");
+    const buffer = Buffer.alloc(128);
+    const read = readSync(descriptor, buffer, 0, 128, 0);
+    const shebang = buffer.subarray(0, read).toString("utf8").split("\n", 1)[0];
+    return shebang.startsWith("#!") && /\bnode\b/u.test(shebang);
+  } catch {
+    return false;
+  } finally {
+    if (descriptor !== undefined) closeSync(descriptor);
+  }
+}
