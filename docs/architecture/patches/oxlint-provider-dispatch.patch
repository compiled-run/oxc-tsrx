@@ -0,0 +1,566 @@
+import { spawn } from "node:child_process";
+import { closeSync, openSync, readSync } from "node:fs";
+import { extensionOf, type ProviderIndex } from "./resolve.ts";
+import {
+  clientOutput,
+  LOG_PREFIX,
+  PROVIDER_DISABLED_ENV,
+  usesNodeInterpreter,
+} from "./shared.ts";
+
+/**
+ * Compose the canonical Oxlint language server and any discovered provider
+ * language servers behind one stdio LSP.
+ *
+ * The editor still talks to exactly one process, `oxlint --lsp`, exactly as it
+ * does today. Every message for a file extension no provider claims is
+ * forwarded to canonical Oxlint byte for byte. A provider server is started
+ * lazily, on the first document message for an extension it claims, so a
+ * session that never opens such a file never pays for a provider process.
+ *
+ * With an empty provider list this module is never loaded at all: `dispatch.ts`
+ * takes today's exact in-process `lint(args, ...)` path.
+ */
+
+const REGISTER_REQUEST_ID = "$/oxc/provider/register-capabilities";
+const CANONICAL_SERVER_REQUEST_PREFIX = "$/oxc/provider/canonical-request/";
+const PROVIDER_PREFIX = "$/oxc/provider/";
+const BROADCAST_NOTIFICATIONS = new Set([
+  "workspace/didChangeConfiguration",
+  "workspace/didChangeWatchedFiles",
+  "workspace/didChangeWorkspaceFolders",
+]);
+
+type Message = Record<string, any>;
+
+function providerInitializeId(id: string): string {
+  return `${PROVIDER_PREFIX}${id}/initialize`;
+}
+
+function providerShutdownId(id: string): string {
+  return `${PROVIDER_PREFIX}${id}/shutdown`;
+}
+
+function providerRequestPrefix(id: string): string {
+  return `${PROVIDER_PREFIX}${id}/request/`;
+}
+
+function requestKey(id: unknown): string {
+  return `${typeof id}:${String(id)}`;
+}
+
+function isRequest(message: Message): boolean {
+  return message?.method !== undefined && message.id !== undefined;
+}
+
+function isResponse(message: Message): boolean {
+  return message?.method === undefined && message?.id !== undefined;
+}
+
+function textDocumentUri(message: Message): string | null {
+  const uri = message?.params?.textDocument?.uri ?? message?.params?.uri;
+  return typeof uri === "string" ? uri : null;
+}
+
+/** Accepts an array, a `Set`, or a discovered `index.extensions` object. */
+export function extensionSet(extensions: unknown): Set<string> {
+  if (extensions === null || extensions === undefined) return new Set();
+  const values =
+    typeof (extensions as any)[Symbol.iterator] === "function"
+      ? (extensions as Iterable<string>)
+      : Object.keys(extensions as object);
+  return new Set([...values].map((extension) => String(extension).toLowerCase()));
+}
+
+/** The lowercase extension of the document a text-document message refers to. */
+export function documentExtension(message: Message): string | null {
+  if (typeof message?.method !== "string" || !message.method.startsWith("textDocument/")) {
+    return null;
+  }
+  const uri = textDocumentUri(message);
+  if (uri === null) return null;
+  try {
+    return extensionOf(decodeURIComponent(new URL(uri).pathname));
+  } catch {
+    return extensionOf(uri.split(/[?#]/u, 1)[0]);
+  }
+}
+
+type Writer = { write(chunk: Uint8Array | string): boolean };
+
+export function writeLspMessage(stream: Writer, message: Message): void {
+  const body = Buffer.from(JSON.stringify(message));
+  stream.write(
+    Buffer.concat([Buffer.from(`Content-Length: ${body.length}\r\n\r\n`, "ascii"), body]),
+  );
+}
+
+export function readLspMessages(
+  stream: NodeJS.ReadableStream,
+  onMessage: (message: Message) => void,
+  onError: (error: Error) => void,
+): () => void {
+  let input = Buffer.alloc(0);
+  const onData = (chunk: Buffer | string) => {
+    input = Buffer.concat([input, Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk)]);
+    for (;;) {
+      const boundary = input.indexOf("\r\n\r\n");
+      if (boundary === -1) return;
+      const header = input.subarray(0, boundary).toString("ascii");
+      const match = /(?:^|\r\n)content-length:\s*(\d+)/iu.exec(header);
+      if (match === null) {
+        onError(new Error(`LSP message is missing Content-Length: ${header}`));
+        return;
+      }
+      const length = Number(match[1]);
+      const bodyStart = boundary + 4;
+      const bodyEnd = bodyStart + length;
+      if (input.length < bodyEnd) return;
+      const body = input.subarray(bodyStart, bodyEnd);
+      input = input.subarray(bodyEnd);
+      try {
+        onMessage(JSON.parse(body.toString("utf8")));
+      } catch (error) {
+        onError(
+          new Error(
+            `LSP message contains invalid JSON: ${
+              error instanceof Error ? error.message : String(error)
+            }`,
+          ),
+        );
+        return;
+      }
+    }
+  };
+  stream.on("data", onData);
+  return () => stream.off("data", onData);
+}
+
+/**
+ * Provider extensions are unknown when the extension host builds its static
+ * document selector, so the routed set is registered dynamically once the
+ * editor reports `initialized`.
+ */
+export function registrationRequest(extensions: unknown): Message {
+  const documentSelector = [...extensionSet(extensions)]
+    .sort()
+    .map((extension) => ({ scheme: "file", pattern: `**/*${extension}` }));
+  const registration = (id: string, method: string, registerOptions: object) => ({
+    id,
+    method,
+    registerOptions: { documentSelector, ...registerOptions },
+  });
+  return {
+    jsonrpc: "2.0",
+    id: REGISTER_REQUEST_ID,
+    method: "client/registerCapability",
+    params: {
+      registrations: [
+        registration("oxc-provider-did-open", "textDocument/didOpen", {}),
+        registration("oxc-provider-did-change", "textDocument/didChange", { syncKind: 1 }),
+        registration("oxc-provider-did-save", "textDocument/didSave", {}),
+        registration("oxc-provider-did-close", "textDocument/didClose", {}),
+        registration("oxc-provider-formatting", "textDocument/formatting", {}),
+        registration("oxc-provider-code-actions", "textDocument/codeAction", {
+          codeActionKinds: ["quickfix"],
+          resolveProvider: false,
+        }),
+      ],
+    },
+  };
+}
+
+interface Endpoint {
+  stdin: NodeJS.WritableStream & Writer;
+  stdout: NodeJS.ReadableStream;
+  stderr?: NodeJS.ReadableStream | null;
+  kill(signal?: NodeJS.Signals): void;
+  once(event: string, listener: (...args: any[]) => void): void;
+}
+
+export interface ProviderSession {
+  id: string;
+  package: string;
+  command: string;
+  extensions: string[];
+  start(): Endpoint;
+}
+
+function endpointExit(endpoint: Endpoint): Promise<{ status: number; signal: string | null }> {
+  return new Promise((resolve, reject) => {
+    endpoint.once("error", reject);
+    endpoint.once("close", (status: number | null, signal: string | null) => {
+      resolve({ status: status ?? 2, signal });
+    });
+  });
+}
+
+export function createProviderLspMultiplexer({
+  clientInput,
+  clientOutput,
+  clientError,
+  canonical,
+  providers = [],
+}: {
+  clientInput: NodeJS.ReadableStream;
+  clientOutput: Writer;
+  clientError: Writer;
+  canonical: Endpoint;
+  providers?: ProviderSession[];
+}) {
+  let clientInitialized = false;
+  let registered = false;
+  let registrationPending = false;
+  let initializeMessage: Message | null = null;
+  let nextCanonicalServerRequest = 1;
+  const canonicalServerRequests = new Map<string, unknown>();
+  const clientRequestTargets = new Map<string, unknown>();
+  const disposeReaders: (() => void)[] = [];
+
+  const sessions = providers.map((provider) => ({
+    provider,
+    extensions: extensionSet(provider.extensions),
+    endpoint: null as Endpoint | null,
+    initializePending: false,
+    initialized: false,
+    failed: false,
+    started: false,
+    shutdownPending: false,
+    exit: null as Promise<{ status: number; signal: string | null }> | null,
+    queued: [] as Message[],
+    serverRequests: new Map<string, unknown>(),
+    nextServerRequest: 1,
+  }));
+  type Session = (typeof sessions)[number];
+  const routedExtensions = new Set(sessions.flatMap((session) => [...session.extensions]));
+
+  const report = (message: string) => clientError.write(`${LOG_PREFIX}${message}\n`);
+  const sendCanonical = (message: Message) => writeLspMessage(canonical.stdin, message);
+  const sendClient = (message: Message) => writeLspMessage(clientOutput, message);
+  const sendSession = (session: Session, message: Message) =>
+    writeLspMessage(session.endpoint!.stdin, message);
+  const protocolError = (source: string) => (error: Error) => {
+    report(`${source} protocol error: ${error instanceof Error ? error.message : String(error)}`);
+  };
+
+  const failQueued = (session: Session, reason: string) => {
+    for (const message of session.queued.splice(0)) {
+      if (!isRequest(message)) continue;
+      clientRequestTargets.delete(requestKey(message.id));
+      sendClient({ jsonrpc: "2.0", id: message.id, error: { code: -32002, message: reason } });
+    }
+  };
+
+  const startSession = (session: Session) => {
+    if (session.started || !clientInitialized || !session.initialized || session.failed) return;
+    session.started = true;
+    sendSession(session, { jsonrpc: "2.0", method: "initialized", params: {} });
+    for (const message of session.queued.splice(0)) sendSession(session, message);
+  };
+
+  const onSessionMessage = (session: Session, message: Message) => {
+    const { id } = session.provider;
+    if (session.initializePending && isResponse(message) && message.id === providerInitializeId(id)) {
+      session.initializePending = false;
+      if (message.error !== undefined) {
+        session.failed = true;
+        report(`the ${id} language server failed to initialize: ${JSON.stringify(message.error)}`);
+        failQueued(session, `The ${id} language server did not initialize`);
+      } else {
+        session.initialized = true;
+        startSession(session);
+      }
+      return;
+    }
+    if (session.shutdownPending && isResponse(message) && message.id === providerShutdownId(id)) {
+      session.shutdownPending = false;
+      return;
+    }
+    if (isRequest(message)) {
+      const proxyId = `${providerRequestPrefix(id)}${session.nextServerRequest++}`;
+      session.serverRequests.set(requestKey(proxyId), message.id);
+      sendClient({ ...message, id: proxyId });
+      return;
+    }
+    if (isResponse(message)) clientRequestTargets.delete(requestKey(message.id));
+    sendClient(message);
+  };
+
+  const ensureSession = (session: Session) => {
+    if (session.endpoint !== null || session.failed) return;
+    if (initializeMessage === null) return;
+    let endpoint: Endpoint;
+    try {
+      endpoint = session.provider.start();
+    } catch (error) {
+      session.failed = true;
+      report(
+        `the ${session.provider.id} language server could not start: ${
+          error instanceof Error ? error.message : String(error)
+        }`,
+      );
+      failQueued(session, `The ${session.provider.id} language server could not start`);
+      return;
+    }
+    session.endpoint = endpoint;
+    session.exit = endpointExit(endpoint).catch(() => ({ status: 2, signal: null }));
+    disposeReaders.push(
+      readLspMessages(
+        endpoint.stdout,
+        (message) => onSessionMessage(session, message),
+        protocolError(`the ${session.provider.id} language server`),
+      ),
+    );
+    endpoint.stderr?.on("data", (chunk: Buffer) => clientError.write(chunk));
+    session.initializePending = true;
+    sendSession(session, { ...initializeMessage, id: providerInitializeId(session.provider.id) });
+  };
+
+  const sessionFor = (message: Message): Session | null => {
+    if (routedExtensions.size === 0) return null;
+    const extension = documentExtension(message);
+    if (extension === null) return null;
+    return sessions.find((session) => session.extensions.has(extension)) ?? null;
+  };
+
+  const deliver = (session: Session, message: Message) => {
+    ensureSession(session);
+    if (session.failed) {
+      if (isRequest(message)) {
+        clientRequestTargets.delete(requestKey(message.id));
+        sendClient({
+          jsonrpc: "2.0",
+          id: message.id,
+          error: {
+            code: -32002,
+            message: `The ${session.provider.id} language server is unavailable`,
+          },
+        });
+      }
+      return;
+    }
+    if (session.started) sendSession(session, message);
+    else session.queued.push(message);
+  };
+
+  const onClientMessage = (message: Message) => {
+    if (isResponse(message)) {
+      if (registrationPending && message.id === REGISTER_REQUEST_ID) {
+        registrationPending = false;
+        if (message.error !== undefined) {
+          report(`the editor rejected provider capabilities: ${JSON.stringify(message.error)}`);
+        }
+        return;
+      }
+      for (const session of sessions) {
+        const original = session.serverRequests.get(requestKey(message.id));
+        if (original === undefined) continue;
+        session.serverRequests.delete(requestKey(message.id));
+        if (session.endpoint !== null) sendSession(session, { ...message, id: original });
+        return;
+      }
+      const canonicalRequest = canonicalServerRequests.get(requestKey(message.id));
+      if (canonicalRequest !== undefined) {
+        canonicalServerRequests.delete(requestKey(message.id));
+        sendCanonical({ ...message, id: canonicalRequest });
+        return;
+      }
+      sendCanonical(message);
+      return;
+    }
+
+    if (message.method === "initialize" && isRequest(message)) {
+      initializeMessage = message;
+      clientRequestTargets.set(requestKey(message.id), "canonical");
+      sendCanonical(message);
+      return;
+    }
+
+    if (message.method === "initialized") {
+      clientInitialized = true;
+      sendCanonical(message);
+      if (routedExtensions.size > 0 && !registered) {
+        registered = true;
+        registrationPending = true;
+        sendClient(registrationRequest(routedExtensions));
+      }
+      for (const session of sessions) startSession(session);
+      return;
+    }
+
+    if (message.method === "shutdown" && isRequest(message)) {
+      clientRequestTargets.set(requestKey(message.id), "canonical");
+      sendCanonical(message);
+      for (const session of sessions) {
+        if (!session.started) continue;
+        session.shutdownPending = true;
+        sendSession(session, { ...message, id: providerShutdownId(session.provider.id) });
+      }
+      return;
+    }
+
+    if (message.method === "exit") {
+      sendCanonical(message);
+      for (const session of sessions) {
+        if (session.endpoint !== null) sendSession(session, message);
+      }
+      return;
+    }
+
+    if (message.method === "$/cancelRequest") {
+      const target = clientRequestTargets.get(requestKey(message.params?.id));
+      if (target !== undefined && target !== "canonical") deliver(target as Session, message);
+      else sendCanonical(message);
+      return;
+    }
+
+    if (BROADCAST_NOTIFICATIONS.has(message.method) && message.id === undefined) {
+      sendCanonical(message);
+      for (const session of sessions) {
+        if (session.started) sendSession(session, message);
+      }
+      return;
+    }
+
+    const session = sessionFor(message);
+    if (session !== null) {
+      if (isRequest(message)) clientRequestTargets.set(requestKey(message.id), session);
+      deliver(session, message);
+      return;
+    }
+
+    if (isRequest(message)) clientRequestTargets.set(requestKey(message.id), "canonical");
+    sendCanonical(message);
+  };
+
+  const onCanonicalMessage = (message: Message) => {
+    if (isRequest(message)) {
+      const proxyId = `${CANONICAL_SERVER_REQUEST_PREFIX}${nextCanonicalServerRequest++}`;
+      canonicalServerRequests.set(requestKey(proxyId), message.id);
+      sendClient({ ...message, id: proxyId });
+      return;
+    }
+    if (isResponse(message)) clientRequestTargets.delete(requestKey(message.id));
+    sendClient(message);
+  };
+
+  disposeReaders.push(
+    readLspMessages(clientInput, onClientMessage, protocolError("editor")),
+    readLspMessages(canonical.stdout, onCanonicalMessage, protocolError("canonical Oxlint")),
+  );
+
+  canonical.stderr?.on("data", (chunk: Buffer) => clientError.write(chunk));
+  clientInput.on("end", () => {
+    canonical.stdin.end();
+    for (const session of sessions) {
+      if (session.endpoint !== null) session.endpoint.stdin.end();
+    }
+  });
+
+  return {
+    extensions: [...routedExtensions].sort(),
+    startedProviders: () =>
+      sessions.filter((session) => session.endpoint !== null).map(({ provider }) => provider.id),
+    closed: (async () => {
+      const canonicalExit = await endpointExit(canonical);
+      const providerExits = await Promise.all(
+        sessions.filter((session) => session.exit !== null).map((session) => session.exit!),
+      );
+      return { canonical: canonicalExit, providers: providerExits };
+    })(),
+    kill(signal?: NodeJS.Signals) {
+      canonical.kill(signal);
+      for (const session of sessions) session.endpoint?.kill(signal);
+    },
+    dispose() {
+      for (const dispose of disposeReaders.splice(0)) dispose();
+    },
+  };
+}
+
+/**
+ * Turn a discovered index into lazily startable language server sessions. Only
+ * providers that declare an `lsp` capability contribute, and the extensions the
+ * index awarded them are the exact routing set.
+ */
+export function providerLspSessions(
+  index: ProviderIndex,
+  spawnProcess: typeof spawn,
+  childOptions: object,
+): ProviderSession[] {
+  const sessions: ProviderSession[] = [];
+  for (const provider of index?.providers ?? []) {
+    const extensions: string[] = [];
+    let command: string | null = null;
+    for (const language of provider.languages) {
+      const capability = language.capabilities?.lsp;
+      if (capability?.kind !== "bin") continue;
+      command = capability.path;
+      for (const extension of language.extensions) {
+        if (index.extensions?.[extension]?.package === provider.name) extensions.push(extension);
+      }
+    }
+    if (command === null || extensions.length === 0) continue;
+    const executable = command;
+    sessions.push({
+      id: provider.id,
+      package: provider.name,
+      command: executable,
+      extensions,
+      start: () =>
+        (usesNodeInterpreter(executable)
+          ? spawnProcess(process.execPath, [executable, "--stdio"], childOptions as any)
+          : spawnProcess(executable, ["--stdio"], childOptions as any)) as unknown as Endpoint,
+    });
+  }
+  return sessions;
+}
+
+/**
+ * Run the canonical Oxlint language server as a child of this process and
+ * multiplex it with the discovered provider servers.
+ *
+ * The canonical half is this very wrapper re-executed with provider dispatch
+ * switched off, so it is byte-identical to `oxlint --lsp` as shipped today and
+ * needs no change on the Rust side. The extra process exists only in `--lsp`
+ * mode and only when at least one provider is installed.
+ */
+export async function runProviderLsp(
+  args: string[],
+  index: ProviderIndex,
+  options: { spawn?: typeof spawn; cwd?: string; entry?: string } = {},
+): Promise<number> {
+  const spawnProcess = options.spawn ?? spawn;
+  const cwd = options.cwd ?? process.cwd();
+  const entry = options.entry ?? process.argv[1];
+  const childOptions = {
+    cwd,
+    env: { ...process.env, [PROVIDER_DISABLED_ENV]: "1", NO_COLOR: "1" },
+    stdio: ["pipe", "pipe", "pipe"] as const,
+  };
+  const providers = providerLspSessions(index, spawnProcess, childOptions);
+  const canonical = spawnProcess(
+    process.execPath,
+    [entry, ...args],
+    childOptions as any,
+  ) as unknown as Endpoint;
+  const multiplexer = createProviderLspMultiplexer({
+    clientInput: process.stdin,
+    // Not `process.stdout`: `cli.ts` has already pointed that at stderr.
+    clientOutput,
+    clientError: process.stderr,
+    canonical,
+    providers,
+  });
+
+  const forwardSignal = (signal: NodeJS.Signals) => multiplexer.kill(signal);
+  const signals: NodeJS.Signals[] = ["SIGINT", "SIGTERM"];
+  for (const signal of signals) process.once(signal, forwardSignal);
+  try {
+    const exits = await multiplexer.closed;
+    return Math.max(exits.canonical.status, ...exits.providers.map((exit) => exit.status), 0);
+  } finally {
+    multiplexer.dispose();
+    for (const signal of signals) process.off(signal, forwardSignal);
+  }
+}
