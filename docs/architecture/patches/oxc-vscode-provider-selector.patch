+import * as path from "node:path";
+import { workspace } from "vscode";
+
+/**
+ * File extensions contributed by installed *language providers*.
+ *
+ * A language provider is an ordinary npm package that declares a static
+ * top-level `oxc.provider` block in its own `package.json`. Oxlint's wrapper
+ * discovers those packages and routes the extensions they claim to the
+ * capability binaries they declare; this module answers the one question the
+ * editor client has to answer for itself, which is *which document types to
+ * hand to the language client at all*.
+ *
+ * The discovery algorithm is not reimplemented here. It is imported from the
+ * `oxlint` package this workspace already resolves, through its
+ * `oxlint/provider-resolve` export, so there is exactly one implementation of
+ * the protocol and it ships with the tool that owns it. An `oxlint` without
+ * that export (any release before providers existed) simply yields no
+ * extensions and the client keeps its built-in list.
+ *
+ * This module changes *resolution only*. It does not touch `activationEvents`
+ * or `contributes.languages`: a provider language still has no VS Code language
+ * id, so the selector patterns below are extension globs, and the extension is
+ * still activated by the built-in `onLanguage:*` events. Generalising
+ * activation is a separate, larger change.
+ */
+
+interface ProviderResolveModule {
+  discoverProviders(options: {
+    root: string;
+    resolve?: (request: string, issuer: string) => string;
+  }): Promise<{ extensions: Record<string, unknown> }>;
+}
+
+async function loadProviderResolve(folder: string): Promise<ProviderResolveModule | undefined> {
+  try {
+    const entry = require.resolve("oxlint/provider-resolve", { paths: [folder] });
+    return (await import(entry)) as ProviderResolveModule;
+  } catch {
+    // No `oxlint` in this folder, or an `oxlint` predating provider support.
+    return undefined;
+  }
+}
+
+/**
+ * Extensions claimed by providers declared in each workspace folder, as a
+ * sorted, deduplicated list of lowercase extensions including the leading dot.
+ *
+ * Never throws: a folder that cannot be indexed contributes nothing and the
+ * caller falls back to the built-in extension list.
+ */
+export async function discoverProviderExtensions(): Promise<string[]> {
+  if (!workspace.isTrusted) {
+    return [];
+  }
+
+  const folders = (workspace.workspaceFolders ?? []).map((folder) => folder.uri.fsPath);
+  const found = new Set<string>();
+
+  for (const folder of folders) {
+    const providerResolve = await loadProviderResolve(folder);
+    if (providerResolve === undefined) continue;
+    try {
+      const index = await providerResolve.discoverProviders({ root: folder });
+      for (const extension of Object.keys(index.extensions ?? {})) {
+        // The protocol stores extensions with a leading dot; the client's
+        // selector patterns use them without one.
+        found.add(extension.replace(/^\./u, "").toLowerCase());
+      }
+    } catch {
+      // A malformed provider must never stop the linter from starting.
+    }
+  }
+
+  return [...found].filter(Boolean).sort();
+}
+
+/**
+ * A document selector pattern covering the built-in extensions plus every
+ * provider-claimed extension, with the built-in list always winning: a provider
+ * cannot take `.ts` or `.js` away from Oxlint, because the protocol reserves
+ * those extensions and refuses to index a provider that claims one.
+ */
+export function documentSelectorPattern(
+  supportedExtensions: readonly string[],
+  providerExtensions: readonly string[],
+): string {
+  const all = [...new Set([...supportedExtensions, ...providerExtensions])].sort();
+  return `**/*.{${all.join(",")}}`;
+}
+
+/** Only used by tests. */
+export function extensionOf(filePath: string): string {
+  return path.extname(filePath).toLowerCase();
+}
