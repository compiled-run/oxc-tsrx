{
  "schemaVersion": 2,
  "version": "0.1.0",
  "repository": "https://github.com/markless-dev/oxc-tsrx",
  "site": {
    "url": "https://oxc-tsrx-docs.vercel.app/",
    "artifact": "docs/dist",
    "provider": "vercel",
    "config": "docs/dist/vercel.json",
    "buildWorkflow": ".github/workflows/site-artifact.yml",
    "trigger": "workflow_dispatch",
    "artifactNameTemplate": "oxc-tsrx-docs-{COMMIT_SHA}",
    "deployWorkflow": null
  },
  "npm": {
    "distTag": "next",
    "publishOrder": [
      "@oxc-tsrx/native-darwin-arm64",
      "@oxc-tsrx/native-darwin-x64",
      "@oxc-tsrx/native-linux-arm64-gnu",
      "@oxc-tsrx/native-linux-x64-gnu",
      "@oxc-tsrx/native-linux-arm64-musl",
      "@oxc-tsrx/native-linux-x64-musl",
      "@oxc-tsrx/native-win32-arm64-msvc",
      "@oxc-tsrx/native-win32-x64-msvc",
      "@oxc-tsrx/runtime",
      "oxlint-tsrx",
      "oxfmt-tsrx"
    ],
    "installPreview": "npm install -D oxlint-tsrx oxfmt-tsrx"
  },
  "vscode": {
    "extensionId": "thejackshelton.oxc-tsrx-vscode",
    "targets": [
      "darwin-arm64",
      "darwin-x64",
      "linux-arm64",
      "linux-x64",
      "alpine-arm64",
      "alpine-x64",
      "win32-arm64",
      "win32-x64"
    ]
  },
  "social": {
    "channel": "X",
    "image": "docs/assets/social-card.png",
    "text": "OXC for TSRX 0.1.0 is out: native Oxlint + Oxfmt for .tsrx, Vite/Vite+ commands, and format-on-save plus lint diagnostics in VS Code, all without forking OXC. Install oxlint-tsrx + oxfmt-tsrx: https://oxc-tsrx-docs.vercel.app/"
  },
  "requiredApprovals": [
    "repository-push",
    "npm-publication",
    "vscode-marketplace-publication",
    "website-deployment",
    "social-announcement"
  ]
}
