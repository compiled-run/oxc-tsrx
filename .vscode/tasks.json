{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check TSRX lint demo server",
      "type": "process",
      "command": "/usr/bin/test",
      "args": [
        "-x",
        "${workspaceFolder}/target/release/oxc-tsrx-lsp"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "check TSRX JavaScript-plugin host",
      "type": "process",
      "command": "/usr/bin/test",
      "args": [
        "-f",
        "${workspaceFolder}/target/oxlint-custom-parser/cli.js"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "build TSRX lint demo extension",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "build:editor"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "build TSRX lint demo",
      "dependsOrder": "parallel",
      "dependsOn": [
        "check TSRX lint demo server",
        "check TSRX JavaScript-plugin host",
        "build TSRX lint demo extension"
      ],
      "problemMatcher": []
    }
  ]
}
