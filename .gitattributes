# Check every text file out with LF on every platform.
#
# Without this, a Windows checkout with the default `core.autocrlf=true` gets
# CRLF in the working tree, and the license tooling then reads bytes that no
# longer match what it recorded. `licenses/oxc/PROVENANCE.json` pins a SHA-256
# per legal file, and `scripts/generate-rust-license-inventory.mjs` and
# `scripts/generate-vscode-license-inventory.mjs` compare against it, so a CRLF
# checkout fails those checks and would publish a tarball whose provenance
# hashes disagree with the files sitting beside them.
* text=auto eol=lf

# Binaries must never be line-ending converted or diffed as text.
*.node   binary
*.wasm   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.zip    binary
*.tgz    binary
*.gz     binary
*.vsix   binary

# Lockfiles are generated. Keep them out of diffs and merge conflicts.
pnpm-lock.yaml  -diff linguist-generated
Cargo.lock      -diff linguist-generated
