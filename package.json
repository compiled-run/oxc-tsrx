{
  "name": "oxc-for-tsrx",
  "version": "0.1.0",
  "description": "Rust-native Oxlint and Oxfmt integration for TSRX",
  "private": true,
  "keywords": [
    "oxc",
    "oxfmt",
    "oxlint",
    "tsrx",
    "vite"
  ],
  "homepage": "https://oxc-tsrx-docs.vercel.app/",
  "bugs": {
    "url": "https://github.com/markless-dev/oxc-tsrx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markless-dev/oxc-tsrx.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "tests"
  ],
  "type": "module",
  "scripts": {
    "build:native": "cargo build --release --locked -p oxc_tsrx_cli --bins",
    "build:parser-native": "node scripts/build-parser-native.mjs",
    "test": "node --test tests/native-lint.test.mjs tests/native-control-lint.test.mjs tests/native-format.test.mjs tests/native-control-format.test.mjs tests/config/native-lint-config.test.mjs tests/config/native-format-config.test.mjs tests/vite/package-seam.test.mjs tests/vite/framework-chain.test.mjs tests/vite/vite-plus-commands.test.mjs tests/type-aware/type-aware.test.mjs tests/editor/lsp.test.mjs tests/editor/demo-workspace.test.mjs tests/editor/package.test.mjs tests/plugins/parser-integrations.test.mjs",
    "test:config": "node --test tests/config/native-lint-config.test.mjs tests/config/native-format-config.test.mjs",
    "test:native-format": "node --test tests/native-format.test.mjs",
    "test:native-lint": "node --test tests/native-lint.test.mjs",
    "test:vite": "node --test tests/vite/package-seam.test.mjs tests/vite/framework-chain.test.mjs tests/vite/vite-plus-commands.test.mjs",
    "test:type-aware": "node --test tests/type-aware/type-aware.test.mjs",
    "test:editor": "node --test tests/editor/lsp.test.mjs tests/editor/demo-workspace.test.mjs tests/editor/package.test.mjs",
    "test:plugins": "node --test tests/plugins/parser-integrations.test.mjs",
    "test:editor:vscode": "node tests/editor/vscode-run.mjs",
    "test:packaging:unit": "node --test tests/packaging/native-version.test.mjs tests/packaging/native-package.test.mjs tests/packaging/runtime-contract.test.mjs tests/packaging/public-package-metadata.test.mjs tests/packaging/boundary.test.mjs tests/packaging/css-boundary.test.mjs tests/packaging/compliance.test.mjs tests/packaging/vscode-build-freshness.test.mjs tests/packaging/vsix-archive.test.mjs tests/packaging/vscode-artifact.test.mjs",
    "test:packaging:clean": "node --test tests/packaging/clean-install.test.mjs",
    "test:packaging:matrix": "node --test tests/packaging/vite-plus-matrix.test.mjs",
    "test:packaging:vscode": "node tests/packaging/vscode-installed-run.mjs",
    "test:packaging": "npm run test:packaging:unit && npm run test:packaging:clean && npm run test:packaging:matrix",
    "package:native": "node scripts/package-native.mjs",
    "package:vscode": "node scripts/package-vscode.mjs",
    "licenses:rust:generate": "node scripts/generate-rust-license-inventory.mjs",
    "licenses:rust:check": "node scripts/generate-rust-license-inventory.mjs --check",
    "licenses:vscode:generate": "node scripts/generate-vscode-license-inventory.mjs",
    "licenses:vscode:check": "npm run build:editor:check && node scripts/generate-vscode-license-inventory.mjs --check",
    "licenses:generate": "npm run licenses:rust:generate && npm run licenses:vscode:generate",
    "licenses:check": "npm run licenses:rust:check && npm run licenses:vscode:check",
    "test:compliance": "node --test tests/packaging/css-boundary.test.mjs tests/packaging/compliance.test.mjs",
    "test:markless-control": "node --test tests/markless-control-corpus.test.mjs",
    "build:editor": "npm run build --workspace=oxc-tsrx-vscode",
    "build:editor:check": "npm run build --workspace=oxc-tsrx-vscode -- --check",
    "docs:build": "node docs/build.mjs",
    "docs:wasm": "node scripts/build-docs-wasm.mjs",
    "docs:transcripts": "node docs/generate-transcripts.mjs",
    "docs:serve": "node docs/serve.mjs",
    "docs:verify": "node docs/verify.mjs",
    "docs:check": "node scripts/check-docs-fresh.mjs",
    "test:site:unit": "node --test tests/site/benchmark-sections.test.mjs tests/site/benchmark-chart-parity.test.mjs tests/site/launch-build.test.mjs",
    "test:site:static": "node tests/site/verify-static.mjs",
    "test:site:wasm": "npm run docs:wasm && node tests/site/verify-static.mjs --require-wasm",
    "test:site": "npm run test:site:unit && npm run test:site:static",
    "test:release": "node --test tests/release/launch-contract.test.mjs",
    "benchmark:native-format": "cargo run --release --locked -p oxc_tsrx_format_benchmark -- --assert benchmarks/native-format/budgets.json",
    "benchmark:native-lint": "cargo run --release --locked -p oxc_tsrx_benchmark -- --assert benchmarks/native-lint/budgets.json",
    "benchmark:type-aware": "node benchmarks/type-aware/run.mjs",
    "benchmark:editor": "node benchmarks/editor/run.mjs",
    "benchmark:comparative": "node benchmarks/comparative/run.mjs --assert"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.3",
    "@napi-rs/wasm-runtime": "^1.1.6",
    "@terrastruct/d2": "^0.1.33",
    "axe-core": "^4.12.1",
    "echarts": "6.1.0",
    "marked": "^18.0.6",
    "minisearch": "^7.2.0",
    "oxc-parser-reference": "npm:oxc-parser@0.140.0",
    "playwright-core": "^1.61.1",
    "rolldown": "1.1.5",
    "shiki": "^4.3.1",
    "tinyglobby": "0.2.17",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
